#!/usr/bin/env bash

#Cores
AMARELO=$'\033[1;33m'
VERDE=$'\033[1;32m'
VERMELHO=$'\033[1;31m'
AZUL=$'\033[1;34m'
RESET=$'\033[0m'

# Pacotes
dpkg=$(dpkg --get-selections | wc -l)
flatpak=$(flatpak list 2>/dev/null | wc -l)

# Bateria
battery_path=$(find /sys/class/power_supply/ -name "BAT*" | head -n1)
battery=$(cat "$battery_path/capacity" 2>/dev/null)

# OS
source /etc/os-release

#SHELL
SHELL_NAME=$(basename "$SHELL")

# CPU
CPU=$(awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo)

# RAM
RAM=$(awk '/MemTotal/ {t=$2} /MemAvailable/ {a=$2} END {printf "%.1f/%.1f GB", (t-a)/1024/1024, t/1024/1024}' /proc/meminfo)

# UP-TIME
UP=$(awk '{print int($1/3600)"h "int(($1%3600)/60)"m"}' /proc/uptime)

# Disk
DISK=$(df -h / | awk 'NR==2 {print $3 " / " $2 " (" $5 ")"}')

# WM
WM=$(pgrep -l "i3|bspwm|openbox|sway" | head -n1 | awk '{print $2}')
WM2=${WM:-${XDG_CURRENT_DESKTOP:-unknown}}

# Arquitetura
ARCH=$(uname -m)

# Resolução
RES=$(xrandr --current | awk '/\*/ {print $1; exit}')

# Logo

echo "=============================="
printf "           ${AMARELO}MFetch${RESET}\n"
echo "=============================="

# Informações

# Informações de User
printf "${AZUL}User${RESET}: %s\n" "$USER@$(hostname)"

# Informações do Sistema operacional
printf "${AZUL}OS${RESET}: %s\n" "$PRETTY_NAME"

# Informações do Kernel
printf "${AZUL}Kernel${RESET}: %s\n" "$(uname -r)"

# Informação da WM
printf "${AZUL}WM${RESET}: %s\n" "$WM2"

# Informações dos pacotes
printf "${AZUL}Packages${RESET}: %s\n" "dpkg $dpkg, flatpak $flatpak"

# Informações da arquitetura
printf "${AZUL}Arquitetura${RESET}: %s\n" "$ARCH"

# Informações do UPTIME
printf "${AZUL}Uptime${RESET}: %s\n" "$UP"

# Informações de data
printf "${AZUL}Date${RESET}: %s\n" "$(date)"

# Informações da CPU
printf "${AZUL}CPU${RESET}: %s\n" "$CPU"

# informações da Resolução
printf "${AZUL}Resolution${RESET}: %s\n"  "$RES"

# Informação da RAM
printf "${AZUL}RAM${RESET}: %s\n" "$RAM"

# Informação da rede wifi ou rede cabeada
if command -v nmcli >/dev/null; then
   WIFI=$(nmcli -t -f DEVICE,TYPE,STATE dev status | awk -F: '$2=="wifi" && $3=="connected"{print $1; exit}')
   ETH=$(nmcli -t -f DEVICE,TYPE,STATE dev status | awk -F: '$2=="ethernet" && $3=="connected"{print $1; exit}')
fi

if [[ -n "$WIFI" ]]; then
    NET="$WIFI"
    printf "${AZUL}Rede${RESET}:  %s\n" "$NET"
elif [[ -n "$ETH" ]]; then
    NET2="$ETH"
    printf "${AZUL}Rede${RESET}:  %s\n" "$NET2"
else
    NET3="Offline"
    printf "${AZUL}Rede${RESET}:  %s\n" "$NET3"
fi

# Informação da rede tor via systemd
if systemctl is-active --quiet tor@default 2>/dev/null; then
    printf "${AZUL}Tor${RESET}: %s\n" "${VERDE}ON${RESET}"
else
    printf "${AZUL}Tor${RESET}: %s\n" "${VERMELHO}OFF${RESET}"
fi

# informação da Bateria
if [[ "$battery" -ge 75 ]]; then
    COLOR=$VERDE
elif [[ "$battery" -ge 50 ]]; then
    COLOR=$AMARELO
else
    COLOR=$VERMELHO
fi
printf "${AZUL}Battery${RESET}: %s\n" "${COLOR}${battery}%${RESET}"

# Informação do Shell
printf "${AZUL}Shell${RESET}: %s\n" "$SHELL_NAME"

# Informação do Disco Rígido
printf "${AZUL}Disk${RESET}: %s\n" "$DISK"

echo "=============================="
